# ============================================================
# MAKORA Phase 3 — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# JAMAIS committer le .env réel en Git
# ============================================================

# Security — CHANGER EN PRODUCTION (openssl rand -hex 32)
SECRET_KEY=makora-dev-secret-CHANGE-IN-PROD
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# Database PostgreSQL 15+
DATABASE_URL=postgresql://makora:makora@localhost:5432/makora_db

# Données
MAKORA_DATA_PATH=./data
MAKORA_DOCUMENTS_PATH=./data/documents
MAKORA_EXPORTS_PATH=./data/exports

# Ollama (LLM backend RCA)
OLLAMA_URL=http://localhost:11434

# API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
PROJECT_NAME=MAKORA
VERSION=1.0.0

# Rate limiting
LOGIN_RATE_LIMIT=5/minute
DEFAULT_RATE_LIMIT=100/minute

# Upload
MAX_UPLOAD_SIZE_MB=50

# makora/.env  (ce fichier est dans ton .gitignore)
DEEPSEEK_MODEL=deepseek-chat

# Quand tu passes à Ollama, tu commentes la ligne ci-dessus et tu ajoutes :
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b